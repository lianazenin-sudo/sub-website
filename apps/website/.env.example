# Google Identity Services (public client ID — safe for the browser)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Signs the httpOnly auth session cookie (server-only — never expose to the client)
AUTH_SESSION_SECRET=replace-with-a-long-random-string

# Supabase project that stores waitlist signups (table: db/waitlist.sql).
# Dashboard → Project Settings → API. The service-role / secret key is server-only —
# never prefix it with NEXT_PUBLIC_ and never expose it to the client.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Alternative to the secret key: the publishable key, limited by the insert-only
# policy in db/waitlist.sql. Used only when SUPABASE_SERVICE_ROLE_KEY is empty.
SUPABASE_PUBLISHABLE_KEY=

# Make.com custom webhook for the landing waitlist (server-only — never expose to the client)
MAKE_WEBHOOK_URL=https://hook.eu2.make.com/xxxxxxxxxxxx

# Resend API key from https://resend.com/api-keys (server-only — never expose to the client).
# When set, each new signup gets the published "waitlist-confirmation" template.
RESEND_API_KEY=

# Optional. Resend template sent to new signups (default: waitlist-confirmation).
RESEND_WAITLIST_TEMPLATE_ID=

# Optional. Sent as "Trace <address>". Defaults to onboarding@resend.dev, which can only
# deliver to your Resend account email until a domain is verified.
RESEND_FROM_EMAIL=

# Inbox that receives waitlist signups (server-only)
WAITLIST_TO_EMAIL=thewaneakhan@gmail.com

# Make.com webhook for the contact form (server-only — never expose to the client)
MAKE_CONTACT_WEBHOOK_URL=https://hook.eu2.make.com/xxxxxxxxxxxx

# Inbox that receives contact form messages (server-only). Messages are also saved
# to the Supabase table contact_messages (db/contact-messages.sql) and emailed via Resend.
CONTACT_TO_EMAIL=thewaneakhan@gmail.com

# Discord community invite used by the "Join Discord" buttons (public)
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/UepYWjjMK
