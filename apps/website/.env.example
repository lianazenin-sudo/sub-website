# Google Identity Services (public client ID — safe for the browser)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Signs the httpOnly auth session cookie (server-only — never expose to the client)
AUTH_SESSION_SECRET=replace-with-a-long-random-string

# Make.com custom webhook for the landing waitlist (server-only — never expose to the client)
MAKE_WEBHOOK_URL=https://hook.eu2.make.com/xxxxxxxxxxxx

# Resend API key from https://resend.com/api-keys (server-only — never expose to the client)
RESEND_API_KEY=

# Optional. Sent as "Trace <address>". Defaults to onboarding@resend.dev, which can only
# deliver to your Resend account email until a domain is verified.
RESEND_FROM_EMAIL=

# Inbox that receives waitlist signups (server-only)
WAITLIST_TO_EMAIL=thewaneakhan@gmail.com

# Make.com webhook for the contact form (server-only — never expose to the client)
MAKE_CONTACT_WEBHOOK_URL=https://hook.eu2.make.com/xxxxxxxxxxxx

# Inbox that receives contact form messages (server-only)
CONTACT_TO_EMAIL=thewaneakhan@gmail.com
